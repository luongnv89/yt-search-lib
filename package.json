{
  "name": "yt-search-lib",
  "version": "1.3.0",
  "description": "Premium client-side YouTube search library using InnerTube API patterns. No API key required.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luongnv89/youtube-search"
  },
  "bugs": {
    "url": "https://github.com/luongnv89/youtube-search/issues"
  },
  "homepage": "https://github.com/luongnv89/youtube-search#readme",
  "scripts": {
    "build": "node build.js",
    "test": "node test.js",
    "test:integration": "node integration.test.js",
    "proxy:start": "node proxy-server.js",
    "test:integration:proxy": "node integration-with-proxy.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"proxy-*.js\" test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "youtube",
    "search",
    "innertube",
    "client-side",
    "no-api-key",
    "javascript",
    "browser",
    "esmodule"
  ],
  "author": "YouTube Search Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
